#| label: fig-lifeexp-trend
#| fig-cap: "Life expectancy by continent, 1952–2007. Grey lines are individual countries; the coloured line is the continent median."
#| fig-width: 8
#| fig-height: 5
ggplot(gapminder, aes(x = year, y = lifeExp)) +
geom_line(aes(group = country), colour = "grey70", alpha = 0.5) +
geom_line(
data = lifeexp_by_continent,
aes(y = median_lifeExp, colour = continent),
linewidth = 1.2,
show.legend = FALSE
) +
facet_wrap(~ continent) +
labs(
x = "Year",
y = "Life expectancy (years)"
) +
theme_minimal()
#| label: fig-lifeexp-trend
#| fig-cap: "Median life expectancy by continent, 1952–2007."
ggplot(lifeexp_by_continent, aes(x = year, y = median_lifeExp, colour = continent)) +
geom_line() +
geom_point() +
labs(
x = "Year",
y = "Median life expectancy (years)",
colour = "Continent"
) +
theme_minimal()
